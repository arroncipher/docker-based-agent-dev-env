# Host root containing dev_env and ticket/repo directories.
CODING_AGENT_WORK_DIR=/Users/arron/work_dir

# Files consumed by the container runtime. Account directories are not mounted wholesale.
CODING_AGENT_SSH_AUTHORIZED_KEYS=/Users/arron/work_dir/dev_env/scripts/ssh/authorized_keys
CODING_AGENT_SING_BOX_CONFIG_DIR=/Users/arron/work_dir/dev_env/scripts/sing-box

# SSH is published by sing_box_gateway on 127.0.0.1:${CODING_AGENT_SSH_PORT}.
CODING_AGENT_SSH_PORT=22001

CODING_AGENT_IMAGE=coding-agent-base:debian-bookworm
CODING_AGENT_SING_BOX_IMAGE=ghcr.io/sagernet/sing-box:latest

# Optional proxy values consumed by runtime config generation or diagnostics.
CODING_AGENT_UPSTREAM_PROXY_SERVER=0.250.250.254
CODING_AGENT_UPSTREAM_PROXY_PORT=7897
