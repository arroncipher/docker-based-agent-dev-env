# 根据 sing-box 是否安装区分：
# 已安装 (Docker容器) - 使用 TUN 模式
# 未安装 (宿主机) - 使用 HTTP 代理

if command -v sing-box >/dev/null 2>&1; then
  CODING_AGENT_PROXY_MODE=sing-box
  CODING_AGENT_UPSTREAM_PROXY_TYPE=http
  CODING_AGENT_UPSTREAM_PROXY_SERVER=0.250.250.254
  CODING_AGENT_UPSTREAM_PROXY_PORT=7897
  CODING_AGENT_SING_BOX_LOG_LEVEL=info
else
  http_proxy=http://0.250.250.254:7897
  https_proxy=http://0.250.250.254:7897
  HTTP_PROXY=http://0.250.250.254:7897
  HTTPS_PROXY=http://0.250.250.254:7897
fi
